{
  "name": "@pb/templates",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Portfolio Builder template registry: shared PortfolioData schema, prebuilt template components, and the build scaffold used for ZIP export and hosting.",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./loaders": {
      "types": "./dist/core/loaders.d.ts",
      "import": "./dist/core/loaders.js"
    },
    "./dist/*": "./dist/*"
  },
  "types": "./dist/core/index.d.ts",
  "scripts": {
    "build": "bun run build:templates && bun run build:core",
    "build:templates": "bun scripts/build-dist.ts",
    "build:core": "tsc -p tsconfig.build.json",
    "prewarm": "bun scripts/prewarm.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.0.0",
    "gsap": "^3.12.0",
    "@gsap/react": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.13.3",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-react": "^6.1.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^8.2.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "motion": "^12.4.0",
    "gsap": "^3.15.0",
    "@gsap/react": "^2.1.2",
    "typescript": "~6.0.3",
    "oxlint": "^1.79.0"
  }
}
